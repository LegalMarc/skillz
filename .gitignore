# Local tooling
.venv/
__pycache__/
*.py[cod]
.DS_Store
# Coverage artefacts. Binary, machine-specific, and they embed the
# absolute paths of whoever ran them - which this repo being public
# makes a small needless disclosure.
.coverage
.coverage.*
htmlcov/
coverage.xml

# Audit output — NEVER commit. This repo is public and HAR/CSV output
# contains unredacted cookie values, headers, and identifiers.
*.har
cookie-audit-*/
*-CONTAINS-RAW-EVIDENCE.zip
cookie-inventory.csv
request-inventory.csv
evidence-private/

# Ad-hoc dated backups made while editing in place (e.g. foo.js.bak-2026-08-25).
# The file stays on disk; git just stops offering to commit it.
*.bak-*
