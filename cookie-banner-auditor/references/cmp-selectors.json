    {
      "id": "hubspot",
      "name": "HubSpot cookie banner",
      "fingerprint": {
        "selectors": ["#hs-eu-cookie-confirmation", "#hs-banner-parent"],
        "script_hosts": ["js.hs-banner.com"]
      },
      "container": ["#hs-eu-cookie-confirmation"],
      "accept": ["#hs-eu-confirmation-button"],
      "reject": ["#hs-eu-decline-button"],
      "settings": ["#hs-eu-cookie-settings-button"],
      "save": [],
      "consent_storage": ["__hs_cookie_cat_pref", "__hs_do_not_track", "__hs_initial_opt_in"],
      "notes": "Element ids carry an 'eu' prefix for historical reasons; the banner is served to every visitor regardless of region. Buttons are labelled plainly 'Accept' and 'Decline', which is exactly the bare-label case that text scoring penalises. 'save' is deliberately empty: the simple banner has no separate save control, and mapping it to the confirmation button would turn a settings-path denial into an acceptance."
    },
